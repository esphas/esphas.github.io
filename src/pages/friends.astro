---
import Layout from '../layouts/Layout.astro';
import friends from '../data/friends.json';

const validFriends = friends.filter(
  (friend) => friend.name?.trim() && friend.link?.trim(),
);
---

<Layout title="Friends">
  {
    validFriends.length === 0 ? (
      <p class="empty-state">还没有友链。</p>
    ) : (
      <ul class="list-plain friends-list">
        {validFriends.map((friend) => (
          <li class="list-item">
            <a href={friend.link} rel="noopener noreferrer" target="_blank">
              <span class="list-item-title">{friend.name}</span>
              <span class="sr-only">（在新窗口打开）</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
