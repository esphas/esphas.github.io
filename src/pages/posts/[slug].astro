---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import {
  getPostNeighbors,
  getPostSlug,
  getPostSummary,
  getSortedPosts,
} from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const sortedPosts = getSortedPosts(await getCollection('posts'));
const slug = getPostSlug(post);
const { previous, next } = getPostNeighbors(sortedPosts, slug);
const description = getPostSummary(post);

const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const published = formatDate(post.data.date);
const modified = post.data.modifiedDate
  ? formatDate(post.data.modifiedDate)
  : null;
const showModified = modified !== null && modified !== published;
---

<Layout title={post.data.title} description={description}>
  <article>
    <div class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          发布于 {published}
        </time>
        {
          showModified && post.data.modifiedDate && (
            <time datetime={post.data.modifiedDate.toISOString()}>
              最后编辑于 {modified}
            </time>
          )
        }
      </div>
    </div>
    <Content />
  </article>
  <div class="post-nav">
    <span>
      {
        previous && (
          <a href={`/posts/${getPostSlug(previous)}/`}>&lt;Previous</a>
        )
      }
    </span>
    <span>
      {next && <a href={`/posts/${getPostSlug(next)}/`}>Next&gt;</a>}
    </span>
  </div>
</Layout>
