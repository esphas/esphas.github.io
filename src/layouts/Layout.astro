---
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  pageHeading?: string;
  pageHeadingHidden?: boolean;
}

const {
  title,
  description = SITE.description,
  pageHeading,
  pageHeadingHidden = false,
} = Astro.props;
const pageTitle = title ? SITE.titleTemplate(title) : SITE.title;
const pathname = Astro.url.pathname;

type NavItem = {
  href: string;
  label: string;
  match: (path: string) => boolean;
  ariaLabel?: string;
};

const navItems: NavItem[] = [
  { href: '/', label: 'Momokoi', match: (path: string) => path === '/' },
  {
    href: '/blog/',
    label: 'Blog',
    match: (path: string) =>
      path.startsWith('/blog/') || path.startsWith('/posts/'),
  },
  {
    href: '/bookmarks/',
    label: 'Bookmarks',
    match: (path: string) => path.startsWith('/bookmarks/'),
  },
  {
    href: '/friends/',
    label: 'Friends',
    match: (path: string) => path.startsWith('/friends/'),
  },
  {
    href: '/rss.xml',
    label: 'RSS',
    ariaLabel: 'RSS 订阅源',
    match: (path: string) => path === '/rss.xml',
  },
  {
    href: '/about/',
    label: 'About',
    match: (path: string) => path.startsWith('/about/'),
  },
];

const isPostPage = pathname.startsWith('/posts/');
const effectiveHeading =
  pageHeading ?? (title && !isPostPage ? title : undefined);
const headingMatchesNav =
  effectiveHeading &&
  navItems.some(
    (item) =>
      item.match(pathname) &&
      (effectiveHeading === item.label || effectiveHeading === item.ariaLabel),
  );
const hidePageHeading = pageHeadingHidden || headingMatchesNav;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <div class="page">
      <div class="page-inner">
        <div class="container">
          <header>
            <nav aria-label="站点导航">
              <ul class="nav-list">
                {
                  navItems.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class:list={[{ 'nav-brand': item.href === '/' }]}
                        data-label={item.label}
                        aria-current={item.match(pathname) ? 'page' : undefined}
                        aria-label={item.ariaLabel}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </header>
          <main id="main-content">
            {
              effectiveHeading && (
                <header
                  class:list={['page-header', { 'sr-only': hidePageHeading }]}
                >
                  <h1 class="page-title">{effectiveHeading}</h1>
                </header>
              )
            }
            <slot />
          </main>
          <footer>
            <small>(C) 2015–{new Date().getFullYear()} Esphas</small>
          </footer>
        </div>
      </div>
    </div>
  </body>
</html>
